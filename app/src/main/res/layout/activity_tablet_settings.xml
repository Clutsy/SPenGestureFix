<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/tablet_settings_title"
            android:textColor="#EAEAEA"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="16dp" />

        <!-- 1. Pressure Curve Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#121212"
            app:strokeColor="#1E1E2E"
            app:strokeWidth="1dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tablet_section_pressure"
                    android:textColor="#EAEAEA"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <!-- Graph View -->
                <com.spengesturefix.PressureCurveView
                    android:id="@+id/curveView"
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:layout_marginBottom="12dp" />

                <!-- Curve Presets ChipGroup -->
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupCurve"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:selectionRequired="true"
                    android:layout_marginBottom="12dp">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipLinear"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tablet_curve_linear" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipSoft"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tablet_curve_soft" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipFirm"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tablet_curve_firm" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipSCurve"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tablet_curve_scurve" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipCustom"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tablet_curve_custom" />
                </com.google.android.material.chip.ChipGroup>

                <!-- Min Pressure Slider -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tablet_pressure_min"
                    android:textColor="#AAAAAA"
                    android:textSize="13sp" />
                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderPressureMin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="0.0"
                    android:valueTo="0.5"
                    android:stepSize="0.01"
                    app:thumbColor="#6C63FF"
                    app:trackColorActive="#6C63FF" />

                <!-- Max Pressure Slider -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tablet_pressure_max"
                    android:textColor="#AAAAAA"
                    android:textSize="13sp" />
                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderPressureMax"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="0.5"
                    android:valueTo="1.0"
                    android:stepSize="0.01"
                    app:thumbColor="#6C63FF"
                    app:trackColorActive="#6C63FF" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 2. Mapping Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#121212"
            app:strokeColor="#1E1E2E"
            app:strokeWidth="1dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tablet_section_mapping"
                    android:textColor="#EAEAEA"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <!-- Orientation ChipGroup -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tablet_orientation"
                    android:textColor="#AAAAAA"
                    android:textSize="13sp"
                    android:layout_marginBottom="4dp" />
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupOrientation"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:selectionRequired="true"
                    android:layout_marginBottom="12dp">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipOrientAuto"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tablet_orientation_auto" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipOrientPort"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tablet_orientation_portrait" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipOrientLand"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tablet_orientation_landscape" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipOrientLandInv"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tablet_orientation_landscape_inv" />
                </com.google.android.material.chip.ChipGroup>

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchInvertX"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/tablet_invert_x"
                    android:textColor="#EAEAEA" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchInvertY"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/tablet_invert_y"
                    android:textColor="#EAEAEA" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchAspectRatio"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/tablet_aspect_lock"
                    android:textColor="#EAEAEA"
                    android:layout_marginBottom="8dp" />

                <!-- Monitor Resolution inputs -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tablet_monitor_res"
                    android:textColor="#AAAAAA"
                    android:textSize="13sp"
                    android:layout_marginBottom="4dp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/etMonitorW"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="W (e.g. 1920)"
                        android:textColor="#EAEAEA"
                        android:textColorHint="#555555"
                        android:inputType="number"
                        android:backgroundTint="#6C63FF" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" x "
                        android:textColor="#888888"
                        android:textSize="18sp"
                        android:layout_gravity="center" />

                    <EditText
                        android:id="@+id/etMonitorH"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="H (e.g. 1080)"
                        android:textColor="#EAEAEA"
                        android:textColorHint="#555555"
                        android:inputType="number"
                        android:backgroundTint="#6C63FF" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 3. Performance Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#121212"
            app:strokeColor="#1E1E2E"
            app:strokeWidth="1dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tablet_section_performance"
                    android:textColor="#EAEAEA"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <!-- Send Rate HZ Slider -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tablet_send_rate"
                    android:textColor="#AAAAAA"
                    android:textSize="13sp" />
                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderSendRate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="30.0"
                    android:valueTo="200.0"
                    android:stepSize="10.0"
                    app:thumbColor="#6C63FF"
                    app:trackColorActive="#6C63FF" />

                <!-- Smoothing Slider -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tablet_smoothing"
                    android:textColor="#AAAAAA"
                    android:textSize="13sp" />
                <com.google.android.material.slider.Slider
                    android:id="@+id/sliderSmoothing"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:valueFrom="0.0"
                    android:valueTo="0.9"
                    android:stepSize="0.05"
                    app:thumbColor="#6C63FF"
                    app:trackColorActive="#6C63FF" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 4. Pen Button Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            app:cardBackgroundColor="#121212"
            app:strokeColor="#1E1E2E"
            app:strokeWidth="1dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/tablet_section_pen_button"
                    android:textColor="#EAEAEA"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp" />

                <!-- Pen Button ChipGroup -->
                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupPenButton"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    app:singleSelection="true"
                    app:selectionRequired="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipBtnRight"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tablet_btn_right_click" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipBtnMiddle"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tablet_btn_middle_click" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipBtnEraser"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tablet_btn_eraser" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipBtnDisabled"
                        style="@style/Widget.MaterialComponents.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/tablet_btn_disabled" />
                </com.google.android.material.chip.ChipGroup>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 5. Display & Global Options -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="32dp"
            app:cardBackgroundColor="#121212"
            app:strokeColor="#1E1E2E"
            app:strokeWidth="1dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchHaptic"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/tablet_haptic"
                    android:textColor="#EAEAEA" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchGrid"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/tablet_show_grid"
                    android:textColor="#EAEAEA" />

                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switchAutoRestore"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/tablet_auto_restore"
                    android:textColor="#EAEAEA" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
